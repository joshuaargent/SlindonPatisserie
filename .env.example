# ============================================
# Slindon Patisserie Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================

# ============================================
# SITE CONFIGURATION
# ============================================

# The full URL of your site (required for production)
# Include trailing slash for best results
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# DATABASE
# ============================================

# SQLite for development, PostgreSQL for production
# For SQLite (dev): file:./dev.db
# For PostgreSQL (prod): postgresql://user:password@localhost:5432/slindon
DATABASE_URL="file:./dev.db"

# ============================================
# SESSION SECRET
# ============================================

# Used for signing session JWTs
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-session-secret-here

# ============================================
# TEYA ONLINE PAYMENTS INTEGRATION
# ============================================
# 
# OAuth credentials from Teya dashboard
# Create credentials in Teya dashboard and use these values

# API URLs
NEXT_PUBLIC_TEYA_API_URL=https://api.teya.io
NEXT_PUBLIC_TEYA_CLIENT_API_URL=https://clientapi.teya.io
NEXT_PUBLIC_TEYA_ASSET_URL=https://assets.teya.io

# OAuth Credentials (from Teya dashboard)
TEYA_CLIENT_ID=4704483f-05ba-4a23-b94d-b612be4ba6a5
TEYA_CLIENT_SECRET=ORrhegxEKLx-i1KtDDk_3JLtX8Xof39xaFLEGKRWJgY
TEYA_STORE_ID=3b31cb01-ebd7-474e-b541-1a4f91e518df

# Webhook Secret (get from Teya dashboard - optional)
TEYA_WEBHOOK_SECRET=

# ============================================
# SOCIAL MEDIA LINKS (Optional)
# ============================================

# GitHub Username (for code/portfolio page)
# Used for repository stats and showcase
GITHUB_USERNAME=joshuaargent

# GitHub Personal Access Token (optional)
# Get from: https://github.com/settings/tokens
# Required for higher API rate limits
GITHUB_TOKEN=

# ============================================
# YOUTUBE INTEGRATION (Optional)
# ============================================

# YouTube API Key (for video stats and subscriber counts)
# Get from: https://console.cloud.google.com/
# Enable YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ============================================
# STRAVA INTEGRATION (Optional)
# ============================================

# Strava API credentials (for running activity tracker)
# Get from: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=

# ============================================
# EMAIL & NEWSLETTER (Optional)
# ============================================

# Resend email API — contact form notifications (TODO: uncomment when API key available)
# Get from: https://resend.com/api-keys
# RESEND_API_KEY=

# Buttondown newsletter API
# Get from: https://buttondown.com/settings/api
BUTTONDOWN_API_KEY=

# Formspree contact form
# Get from: https://formspree.io/
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# ============================================
# ANALYTICS (Optional)
# ============================================

# These are automatically configured when deploying to Vercel
# No additional setup needed

# ============================================
# SEO (Optional)
# ============================================

# Google Search Console verification
# GOOGLE_VERIFICATION_CODE=your_verification_code